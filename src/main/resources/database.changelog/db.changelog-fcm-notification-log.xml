<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20251111-02-create-fcm-notification-log" author="bhargavachandrabadam">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="fcm_notification_log"/>
            </not>
        </preConditions>
        <createTable tableName="fcm_notification_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="identity_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="identity_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="fcm_token" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="body" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="data_payload" type="TEXT"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="response_id" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_fcm_notification_log_identity_id_type" tableName="fcm_notification_log">
            <column name="identity_id"/>
            <column name="identity_type"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
