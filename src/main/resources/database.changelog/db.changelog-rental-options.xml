<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20250929-01-create-rental-options" author="bhargavachandrabadam">
        <createTable tableName="rental_options">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="duration_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="sharing_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="pg_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="rental_options"
                                baseColumnNames="pg_id"
                                referencedTableName="pg_details"
                                referencedColumnNames="id"
                                constraintName="fk_rental_options_pg_details"/>
    </changeSet>
    <changeSet id="20250929-02-add-caution-deposit" author="bhargavachandrabadam">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="pg_details"/>
        </preConditions>
        <addColumn tableName="rental_options">
            <column name="caution_deposit" type="DECIMAL(12,2)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
