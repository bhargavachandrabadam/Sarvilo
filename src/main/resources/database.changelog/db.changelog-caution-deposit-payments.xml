<databaseChangeLog
xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

<changeSet id="create-caution-deposit-payments-table" author="bhargavachandrabadam">
    <preConditions onFail="MARK_RAN">
        <not>
            <tableExists tableName="caution_deposit_payments"/>
        </not>
    </preConditions>
    <createTable tableName="caution_deposit_payments">
        <column name="id" type="BIGINT" autoIncrement="true">
            <constraints primaryKey="true" nullable="false"/>
        </column>
        <column name="user_id" type="BIGINT">
            <constraints nullable="false"/>
        </column>
        <column name="amount_paid" type="DECIMAL(19,2)">
            <constraints nullable="false"/>
        </column>
        <column name="payment_date" type="TIMESTAMP">
            <constraints nullable="false"/>
        </column>
        <column name="mode" type="VARCHAR(32)">
            <constraints nullable="false"/>
        </column>
        <column name="transaction_ref" type="VARCHAR(255)"/>
        <column name="status" type="VARCHAR(32)">
            <constraints nullable="false"/>
        </column>
        <column name="booking_id" type="BIGINT">
            <constraints nullable="false"/>
        </column>
    </createTable>
    <addForeignKeyConstraint
            baseTableName="caution_deposit_payments"
            baseColumnNames="booking_id"
            referencedTableName="booking_request"
            referencedColumnNames="id"
            constraintName="fk_caution_deposit_booking"/>
</changeSet>
<!-- Add index for booking_id to improve query performance -->
<changeSet id="add-index-booking-id-caution-deposit-payments" author="bhargavachandrabadam">
    <createIndex indexName="idx_caution_deposit_payments_booking_id"
                 tableName="caution_deposit_payments">
        <column name="booking_id"/>
    </createIndex>
</changeSet>
</databaseChangeLog>
