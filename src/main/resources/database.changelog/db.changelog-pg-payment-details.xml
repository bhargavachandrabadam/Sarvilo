<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="add-pg-payment-details-fields-20251006" author="bhargavachandrabadam">
        <preConditions onFail="MARK_RAN">
            <not>
            <tableExists tableName="pg_details"/>
            </not>
        </preConditions>
        <addColumn tableName="pg_details">
            <column name="upi_address" type="varchar(255)"/>
            <column name="gstin" type="varchar(255)"/>
            <column name="bank_account_number" type="varchar(255)"/>
            <column name="account_holder_name" type="varchar(255)"/>
            <column name="ifsc" type="varchar(255)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>

