<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20250917-tenant-info" author="bhargavachandrabadam">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tenant_info"/>
            </not>
        </preConditions>
        <createTable tableName="tenant_info">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="proof" type="VARCHAR(255)"/>
            <column name="rental_type" type="VARCHAR(100)"/>
            <column name="notes" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="tenant_info"
            baseColumnNames="user_id"
            referencedTableName="users"
            referencedColumnNames="id"
            constraintName="fk_tenant_info_user_id"
            onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="20250918-tenant-info-extend" author="bhargavachandrabadam">
        <preConditions onFail="MARK_RAN">
            <and>
                <not>
                    <columnExists tableName="tenant_info" columnName="proof_type"/>
                </not>
                <columnExists tableName="tenant_info" columnName="proof"/>
            </and>
        </preConditions>
        <addColumn tableName="tenant_info">
            <column name="proof_type" type="VARCHAR(100)"/>
            <column name="proof_photo_url" type="VARCHAR(255)"/>
            <column name="tenant_photo_url" type="VARCHAR(255)"/>
        </addColumn>
        <dropColumn tableName="tenant_info" columnName="proof"/>
    </changeSet>

    <changeSet id="20251009-tenant-info-drop-rental-type-fk" author="copilot">
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists foreignKeyName="fksrmyw40shnwophbjt6v3sr1cw"/>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="tenant_info" constraintName="fksrmyw40shnwophbjt6v3sr1cw"/>
    </changeSet>

    <changeSet id="20251030-tenant-info-add-pg-id" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="tenant_info" columnName="pg_id"/>
            </not>
        </preConditions>
        <addColumn tableName="tenant_info">
            <column name="pg_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint
            baseTableName="tenant_info"
            baseColumnNames="pg_id"
            referencedTableName="pg_details"
            referencedColumnNames="id"
            constraintName="fk_tenant_info_pg_id"
            onDelete="SET NULL"/>
    </changeSet>

    <!-- Add created_at column with default value for existing rows -->
    <changeSet id="20251103-tenant-info-add-created-at" author="bhargavachandrabadam">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="tenant_info" columnName="created_at"/>
            </not>
        </preConditions>
        <addColumn tableName="tenant_info">
            <column name="created_at" type="timestamp(6)" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Optionally drop the default value if you want to enforce explicit value on insert -->
    <changeSet id="20251103-tenant-info-drop-default-created-at" author="bhargavachandrabadam">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="tenant_info" columnName="created_at"/>
        </preConditions>
        <dropDefaultValue tableName="tenant_info" columnName="created_at"/>
    </changeSet>
    <changeSet id="20251104-tenant-info-notes-nullable" author="bhargavachandrabadam">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="tenant_info" columnName="notes"/>
        </preConditions>
        <dropNotNullConstraint tableName="tenant_info" columnName="notes" columnDataType="VARCHAR(255)"/>
    </changeSet>
    <changeSet id="drop-rental-type-from-tenant-info" author="bhargavachandrabadam">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="tenant_info" columnName="rental_type"/>
        </preConditions>
        <dropColumn tableName="tenant_info" columnName="rental_type"/>
    </changeSet>

</databaseChangeLog>
