<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20251030-01-create-booking-request-proof-photos" author="bhargavachandrabadam">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="booking_request_proof_photos"/>
            </not>
        </preConditions>
        <createTable tableName="booking_request_proof_photos">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="booking_request_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="proof_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="proof_photo_url" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="booking_request_proof_photos"
                                 baseColumnNames="booking_request_id"
                                 referencedTableName="booking_requests"
                                 referencedColumnNames="id"
                                 constraintName="fk_booking_request_proof_photos_booking_request_id"/>
    </changeSet>

</databaseChangeLog>

