# Updated .dockerignore — keep the build context small but allow files needed to build inside Docker

# Exclude compiled outputs; allow the built jar artefact if present
target/
!target/*.jar

# Git / IDE files
.git
.gitignore
.vscode
.idea
*.iml

# Node / other local artifacts
node_modules
npm-debug.log
.DS_Store

# Allow essential build and Docker files
!pom.xml
!mvnw
!mvnw.cmd
!.mvn/
!src/
!Dockerfile
!.dockerignore
!README.md
